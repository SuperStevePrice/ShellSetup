#!/usr/bin/env -S python3 -u
"""
syncAllProjects.py

Synchronize ~/Projects repositories across all machines.

Features:
  - Pull existing repositories
  - Clone missing repositories
  - Skip symbolic links
  - Skip *.backup repositories
  - Safe non-interactive SSH
  - Designed for use with tee logging
"""

import subprocess
import sys
import argparse
from pathlib import Path


MACHINES = {
    "MacBook Pro": "127.0.0.1",
    "steves-imac": "100.77.201.99",
    "imac-linux": "100.112.55.50",
    "macbookpro-linux": "100.73.104.80",
}

GITHUB_USER = "SuperStevePrice"

SSH_OPTIONS = (
    "-T "
    "-o BatchMode=yes "
    "-o ConnectTimeout=10"
)


def run_command(cmd):
    return subprocess.run(
        cmd,
        shell=True,
        capture_output=True,
        text=True
    )


def ssh_command(ip, command):
    return f"ssh {SSH_OPTIONS} {ip} '{command}'"


def find_git_projects(base_path="~/Projects"):
    """
    Find active git repositories.

    Excludes:
      - symbolic links
      - *.backup repositories
    """

    base = Path(base_path).expanduser()
    projects = {}

    if not base.exists():
        print(f"❌ {base} does not exist")
        return projects

    for item in sorted(base.iterdir()):

        if item.is_symlink():
            continue

        if item.name.endswith(".backup"):
            continue

        if item.is_dir() and (item / ".git").exists():
            projects[item.name] = str(item)

    return projects


def sync_project(project_name, repo_path):

    for machine_name, ip in MACHINES.items():

        print(f"  ⏳ {machine_name:<18}", end=" ", flush=True)

        if ip == "127.0.0.1":

            test_cmd = f"test -d '{repo_path}/.git'"

            pull_cmd = (
                f"cd '{repo_path}' && git pull"
            )

            clone_cmd = (
                f"cd ~/Projects && "
                f"git clone "
                f"git@github.com:{GITHUB_USER}/{project_name}.git"
            )

        else:

            remote_path = f"~/Projects/{project_name}"

            test_cmd = ssh_command(
                ip,
                f"test -d {remote_path}/.git"
            )

            pull_cmd = ssh_command(
                ip,
                f"cd {remote_path} && git pull"
            )

            clone_cmd = ssh_command(
                ip,
                f"cd ~/Projects && "
                f"git clone "
                f"git@github.com:{GITHUB_USER}/{project_name}.git"
            )


        check = run_command(test_cmd)

        if check.returncode == 0:

            result = run_command(pull_cmd)

            if result.returncode == 0:

                if "Already up to date" in result.stdout:
                    print("✅ current")

                elif (
                    "Fast-forward" in result.stdout
                    or "files changed" in result.stdout
                ):
                    print("✅ updated")

                else:
                    print("✅ pulled")

            else:
                print("❌ pull failed")
                print(result.stderr.strip())

        else:

            print("📥 cloning")

            result = run_command(clone_cmd)

            if result.returncode == 0:
                print("      cloned")

            else:
                print(result.stderr.strip())
                print("      clone failed")


def main():

    parser = argparse.ArgumentParser(
        description="Synchronize ~/Projects repositories"
    )

    parser.add_argument(
        "-p",
        "--project",
        nargs="+",
        help="Specific projects to sync"
    )

    args = parser.parse_args()


    projects = find_git_projects()

    if not projects:
        print("❌ No git projects found")
        sys.exit(1)


    print(
        f"🔍 Found {len(projects)} project(s): "
        f"{', '.join(projects.keys())}\n"
    )


    if args.project:
        projects_to_sync = args.project
    else:
        projects_to_sync = list(projects.keys())


    for project in projects_to_sync:

        if project not in projects:
            print(f"❌ Unknown project: {project}")
            continue

        print(f"📦 {project}")
        sync_project(project, projects[project])


    print("\n✅ All machines synchronized")


if __name__ == "__main__":
    main()
